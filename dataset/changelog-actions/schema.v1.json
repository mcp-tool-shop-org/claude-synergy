{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcp-tool-shop-org/claude-synergy/dataset/changelog-actions/schema.v1.json",
  "title": "changelog-actions entry, v1",
  "description": "One curated (changelog_entry -> structured_action) example. See SCHEMA.md for field rules.",
  "type": "object",
  "required": ["id", "schema_version", "input", "output", "provenance", "quality"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^syn-[A-Za-z0-9._@-]+$",
      "minLength": 5,
      "maxLength": 200,
      "description": "Stable ID: syn-<product>-<version>-<ordinal>. Permissive enough to encode scoped-npm package names (containing @) after / has been sanitized to -."
    },
    "schema_version": { "const": "1" },

    "input": {
      "type": "object",
      "required": ["product", "version", "kind_hint", "change_text", "source_url", "change_id"],
      "additionalProperties": false,
      "properties": {
        "product": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "released_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "kind_hint": { "type": "string", "description": "Raw kind from changelog parser (added/fixed/breaking/deprecated/...)" },
        "change_text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "source_url": { "type": "string", "format": "uri" },
        "change_id": {
          "type": "string",
          "pattern": "^[a-z0-9][A-Za-z0-9._@/-]+/[0-9]+$",
          "minLength": 5,
          "maxLength": 200,
          "description": "product/version/ordinal — must exist in source corpus. Permissive enough to round-trip scoped-npm version strings (e.g. @modelcontextprotocol/client@2.0.0-alpha.1)."
        }
      }
    },

    "output": {
      "type": "object",
      "required": ["kind", "severity", "subject", "action_text", "deadline", "tags"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["breaking", "deprecation", "security", "feature", "fix", "performance", "docs", "unknown"],
          "description": "8-enum. `fix` added per Phase A1 swarm — Keep-a-Changelog + Conventional Commits + Lientz-Swanson maintenance theory all separate corrective from perfective; collapsing causes label collapse at small-N fine-tunes (Shwartz-Ziv NeurIPS 2023, arXiv:2312.02517). `performance` is for DELIBERATE optimization only. `security` is for CVE/GHSA-class only."
        },
        "severity": { "enum": ["low", "medium", "high"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "action_text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "deadline": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date if upstream named one; else null. Never inferred."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "maxItems": 10
        }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["labeler", "labeled_at", "reviewer", "reviewed_at", "review_action"],
      "additionalProperties": false,
      "properties": {
        "labeler": { "type": "string" },
        "labeled_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "review_action": { "enum": ["approved", "edited", "rejected", "pending"] }
      }
    },

    "quality": {
      "type": "object",
      "required": ["faithfulness", "schema_valid"],
      "additionalProperties": false,
      "properties": {
        "faithfulness": { "enum": ["ok", "missing-citation", "citation-mismatch"] },
        "schema_valid": { "type": "boolean" },
        "human_grade": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
      }
    }
  }
}
